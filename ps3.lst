   77693/   3F352 :                     ; --------------------------------------------------------------------
   77694/   3F352 :                     ; Data is made up of 4 bytes and the processing of this data terminates
   77695/   3F352 :                     ; when it reaches $FF.
   77696/   3F352 :                     ;
   77697/   3F352 :                     ; Byte 1 = Generation index: this byte is compared with the value in the generation_index
   77698/   3F352 :                     ;		   value, and if the values are not the same, the next 4 bytes are processed
   77699/   3F352 :                     ;
   77700/   3F352 :                     ; Byte 2 = event_flags offset; if the flag is set, it updates
   77701/   3F352 :                     ;		   the scene_id value with the following 2 bytes, otherwise they are skipped
   77702/   3F352 :                     ;
   77703/   3F352 :                     ; Bytes 3-4 = new scene ID
   77704/   3F352 :                     ; --------------------------------------------------------------------
