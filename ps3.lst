(1)   14/       0 :                     
(1)   15/       0 :                     ; define the cnop pseudo-instruction
(1)   16/       0 :                     cnop macro offset,alignment
(1)   17/       0 :                     	if notZ80(MOMCPU)
(1)   18/       0 :                     		org (*-1+(alignment)-((*-1+(-(offset)))#(alignment)))
(1)   19/       0 :                     	else
(1)   20/       0 :                     		org ($-1+(alignment)-(($-1+(-(offset)))#(alignment)))
(1)   21/       0 :                     	endif
(1)   22/       0 :                         endm
(1)   23/       0 :                     
(1)   24/       0 :                     ; redefine align in terms of cnop, for the padding counter
(1)   25/       0 :                     align macro alignment
(1)   26/       0 :                     		cnop 0,alignment
