   76646/   3ECD0 :                     
   76647/   3ECD0 :                     ; ======================================================================
   76648/   3ECD0 :                     ; Data and input for the demos
   76649/   3ECD0 :                     ;
   76650/   3ECD0 :                     ; A pair of byte is read each frame to determine what to do
   76651/   3ECD0 :                     ;
   76652/   3ECD0 :                     ; Byte 1 = if value is 0, then the next byte represents the index of the DemoScriptOffsets
   76653/   3ECD0 :                     ; 			table; when not 0, it's the duration that the input determined by the value of next
   76654/   3ECD0 :                     ;			byte will take
   76655/   3ECD0 :                     ;
   76656/   3ECD0 :                     ; Byte 2 = if preceding byte is 0, then it's the index of the DemoScriptOffsets table, otherwise
   76657/   3ECD0 :                     ;			it's the input whose duration depends on the value of the 1st byte
   76658/   3ECD0 :                     ; ======================================================================
   76659/   3ECD0 :                     
