(1)   53/       0 :                     chkop function op,ref,(substr(lowstring(op),0,strlen(ref))<>ref)
(1)   54/       0 :                     
(1)   55/       0 :                     ; 1-arg instruction that's self-patching to remove 0-offset optimization
(1)   56/       0 :                     insn1op	 macro oper,x
(1)   57/       0 :                     	  if (chkop("x","0("))
(1)   58/       0 :                     		!oper	x
