   75267/   3C70A :                     ; =========================================================
   75268/   3C70A :                     ; Scene Settings
   75269/   3C70A :                     ;
   75270/   3C70A :                     ; byte 1 = tile width of the scene
   75271/   3C70A :                     ; byte 2 = tile height of the scene
   75272/   3C70A :                     ; byte 3 = ?
   75273/   3C70A :                     ; byte 4 = ?
   75274/   3C70A :                     ; byte 5 = handles encounters; $FF enables battle, $00 disables enemy encounters
   75275/   3C70A :                     ; byte 6 = Index for battle backgrounds
   75276/   3C70A :                     ;		00 = grass
   75277/   3C70A :                     ;		04 = snow
   75278/   3C70A :                     ;		08 = desert
   75279/   3C70A :                     ;		0C = stars & clouds (satellite)
   75280/   3C70A :                     ;		14 = Island Cave/Wren's Cave
   75281/   3C70A :                     ;		18 = advanced dungeons
   75282/   3C70A :                     ;		1C = castle
   75283/   3C70A :                     ;		20 = castle
   75284/   3C70A :                     ;		24 = Rebels' Cave
   75285/   3C70A :                     ;		28 = castle dungeon
   75286/   3C70A :                     ;		2C = castle dungeon
   75287/   3C70A :                     ;		30 = Divisia dungeon
   75288/   3C70A :                     ; byte 7 = music ID
   75289/   3C70A :                     ; byte 8 = scene type? affects how a scene is drawn and collision
   75290/   3C70A :                     ; =========================================================
