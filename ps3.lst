   71046/   398B0 :                     
   71047/   398B0 :                     ; =================================================
   71048/   398B0 :                     ; Techniques can either be used for enemies or allies dependent on how they're set and who is using them.
   71049/   398B0 :                     ; The same index is carried over to enemy data for the tech copies and poison.
   71050/   398B0 :                     ;
   71051/   398B0 :                     ; byte 1-8 = Name (ends with $FC); shows up in battle
   71052/   398B0 :                     ; byte 9 = ?
   71053/   398B0 :                     ; byte 10 = Target
   71054/   398B0 :                     ;	02 = single ally
   71055/   398B0 :                     ;	04 = all allies
   71056/   398B0 :                     ;	06 = dead ally (Rever uses this)
   71057/   398B0 :                     ;	0A = single enemy
   71058/   398B0 :                     ;	OC = single enemy row
   71059/   398B0 :                     ;	0E = left or right groups
   71060/   398B0 :                     ;	10 = all enemies
   71061/   398B0 :                     ;	12 = escape statistic? (presumed, as it's only used with Rimit)
   71062/   398B0 :                     ; byte 11 = TP cost
   71063/   398B0 :                     ; byte 12 = index
   71064/   398B0 :                     ; byte 13-16 = ??
