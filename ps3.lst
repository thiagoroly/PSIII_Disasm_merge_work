   64013/   351C8 :                     ; =====================================================
   64014/   351C8 :                     
   64015/   351C8 :                     ; ======================================================================
   64016/   351C8 :                     ; Scene transition data
   64017/   351C8 :                     ;
   64018/   351C8 :                     ;   Access points and data when you change scenes
   64019/   351C8 :                     ;
   64020/   351C8 :                     ; First word is the number of map transition chunks. Each chunk is made
   64021/   351C8 :                     ; up of 16 bytes
   64022/   351C8 :                     ;
   64023/   351C8 :                     ; Bytes 1-2: X coordinates on current scene
   64024/   351C8 :                     ; Bytes 3-4: Y coordinates on current scene
   64025/   351C8 :                     ; Bytes 5-6: Scene to move to
   64026/   351C8 :                     ; Bytes 7-8: X coordinates on scene moved to
   64027/   351C8 :                     ; Bytes 9-10: Y coordinates on scene moved to
   64028/   351C8 :                     ; Bytes 11-12: pixel size of transition point (32x32)
   64029/   351C8 :                     ; Bytes 13-14: screen X and Y coordinates, shifts in tile-sized increments
   64030/   351C8 :                     ; Byte 15: Type of access
   64031/   351C8 :                     ;		0 = normal access
   64032/   351C8 :                     ;		1 = blocked cave, gemstone required for access
   64033/   351C8 :                     ;		2 = normal access and makes it possible to use the Escapipe
   64034/   351C8 :                     ;		3 = submersible access (used for Laya's world, Sub Parts required)
   64035/   351C8 :                     ; Byte 16: index of gem required for entry
   64036/   351C8 :                     ;		0 = Sapphire
   64037/   351C8 :                     ;		1 = No entry
   64038/   351C8 :                     ;		2 = TwinsRuby
   64039/   351C8 :                     ;		3 = DragnTear
   64040/   351C8 :                     ;		4 = MstryStar
   64041/   351C8 :                     ; ======================================================================
