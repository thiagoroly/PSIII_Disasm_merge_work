   52343/   25FCA : 6865 7220 686F 7264 	dc.b	"her hordes of monsters."
                    6573 206F 6620 6D6F 
                    6E73 7465 7273 2E   
   52344/   25FE1 : EC                  	dc.b	$EC
   52345/   25FE2 : 496E 2074 6865 2066 	dc.b	"In the final battle, all"
                    696E 616C 2062 6174 
                    746C 652C 2061 6C6C 
   52346/   25FFA : EC                  	dc.b	$EC
   52347/   25FFB : 636F 6D62 6174 616E 	dc.b	"combatants were killed,"
                    7473 2077 6572 6520 
                    6B69 6C6C 6564 2C   
   52348/   26012 : EC                  	dc.b	$EC
   52349/   26013 : 7468 6F75 6768 204F 	dc.b	"though Orakio and Laya's"
                    7261 6B69 6F20 616E 
                    6420 4C61 7961 2773 
   52350/   2602B : EC                  	dc.b	$EC
   52351/   2602C : 626F 6469 6573 2077 	dc.b	"bodies were never found."
                    6572 6520 6E65 7665 
                    7220 666F 756E 642E 
   52352/   26044 : EC                  	dc.b	$EC
   52353/   26045 : 5468 6520 7061 7373 	dc.b	"The passageways between"
                    6167 6577 6179 7320 
                    6265 7477 6565 6E   
   52354/   2605C : EC                  	dc.b	$EC
   52355/   2605D : 7468 6520 4C61 7961 	dc.b	"the Layan worlds and the"
                    6E20 776F 726C 6473 
                    2061 6E64 2074 6865 
   52356/   26075 : EC                  	dc.b	$EC
   52357/   26076 : 4F72 616B 6961 6E20 	dc.b	"Orakian worlds were"
                    776F 726C 6473 2077 
