   38412/   1E032 :                     ; =======================
   38413/   1E032 :                     
   38414/   1E032 :                     
   38415/   1E032 :                     ; ======================================================================
   38416/   1E032 :                     ; Characters' initial data
   38417/   1E032 :                     ;
   38418/   1E032 :                     ; Byte 1: Character ID
   38419/   1E032 :                     ; Byte 2: HP
   38420/   1E032 :                     ; Byte 3: TP
   38421/   1E032 :                     ; Byte 4: Attack
   38422/   1E032 :                     ; Byte 5: Defense
   38423/   1E032 :                     ; Byte 6: Speed
   38424/   1E032 :                     ; Byte 7: ?
   38425/   1E032 :                     ; Bytes 8-12: Character's name; end name delimiter is $FC; remaining bytes, if any, are padded with $00's
   38426/   1E032 :                     ; Byte 13: Luck
   38427/   1E032 :                     ; Byte 14: Skill
   38428/   1E032 :                     ; Bytes 15-16: Offset to EXP table
   38429/   1E032 :                     ; Bytes 17-18: Offset to Technique growth rate
   38430/   1E032 :                     ; Bytes 19-20: Number of items
   38431/   1E032 :                     ; Bytes 21-?: variable list of items which depends on number above
   38432/   1E032 :                     ; 		$8000 = Head
   38433/   1E032 :                     ; 		$8002 = Right Hand
   38434/   1E032 :                     ; 		$8004 = Left Hand
   38435/   1E032 :                     ; 		$8006 = Torso
   38436/   1E032 :                     ; 		$8008 = Feet
   38437/   1E032 :                     ; 		$800A = Buckle
   38438/   1E032 :                     ; 		$800C = Both Hands
   38439/   1E032 :                     ;
   38440/   1E032 :                     ; After the initial items are the bytes for the technique grid
   38441/   1E032 :                     ;
   38442/   1E032 :                     ; For the technique grids, each one corresponds with four bytes for each half (left and right respectively, eight bytes in total).
   38443/   1E032 :                     ; If the technique isn't a starting tech, the field is left blank with a "0".
   38444/   1E032 :                     ;
   38445/   1E032 :                     ;	0150	The first two bytes of a grid correspond to the upper left corner. The first value is the width, the second is for the height.
   38446/   1E032 :                     ;	2  6	The third and fourth bytes determine the width and then height of the lower left corner.
   38447/   1E032 :                     ;	4  8	The fifth and six are for the upper right corner.the seventh and eighth are for the lower right.
   38448/   1E032 :                     ; 	0370	(Forgive the poor ASCII art, 0 is placeholders for the corners)
   38449/   1E032 :                     ;
   38450/   1E032 :                     ; The sets are listed as follows:
   38451/   1E032 :                     ; 	Melee(left side 1-4), Melee(right side 5-8), Heal(left), Heal(right), Time(left), Time(right), Order(left), Order(right)
   38452/   1E032 :                     ;
   38453/   1E032 :                     ; Mieu's techniques, as an example:
   38454/   1E032 :                     ;	dc.l	0, 0, $02020202, $02020202, 0, 0, $02020202, $02020202
   38455/   1E032 :                     ;
   38456/   1E032 :                     ; She will start with Heal and Order techs of a 4x4 grid; each value gives a width and height of 2, totaling as "3" for tech power.
   38457/   1E032 :                     ;
   38458/   1E032 :                     ; Initialized grid size values: (increases in odd-numbered increments)
   38459/   1E032 :                     ;	01 = 1
   38460/   1E032 :                     ;	02 = 3 (lowest starting value set in game) Mieu, Wren, Thea, Kara(both)
   38461/   1E032 :                     ;	03 = 5 Crys
   38462/   1E032 :                     ;	04 = 7 Lyle, Laya, Gwyn
   38463/   1E032 :                     ;	05 = 9 Ayn, Ryan
   38464/   1E032 :                     ;	06 = 11 (highest starting value set in game) Sean, Aron, Adan
   38465/   1E032 :                     ;	07 = 13
   38466/   1E032 :                     ;	08 = 15
   38467/   1E032 :                     ;	09 = 17
   38468/   1E032 :                     ;	0A = 19	;etc.
   38469/   1E032 :                     ;
   38470/   1E032 :                     ; Note: It is not recommended to set high numbers, the grid's display runs off the screen in the tech rebalance shop.
   38471/   1E032 :                     ; If you mix and match numbers, you will have uneven sized grids rather than the standard (like 4x4).
   38472/   1E032 :                     ; ======================================================================
   38473/   1E032 :                     
   38474/   1E032 :                     ;=======================================================================
