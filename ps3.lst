   71627/   3A5F0 :                     
   71628/   3A5F0 :                     
   71629/   3A5F0 :                     ; ========================================================================
   71630/   3A5F0 :                     ; Enemies that appear in the front row
   71631/   3A5F0 :                     ;
   71632/   3A5F0 :                     ; Bytes 1-4 = Art pointer
   71633/   3A5F0 :                     ; Bytes 5-6 = ID for the enemy (starts from 1)
   71634/   3A5F0 :                     ; Bytes 7-8 = Index of EnemyObjOffset table
   71635/   3A5F0 :                     ; Bytes 9-10 = Enemy name pointer
   71636/   3A5F0 :                     ; Bytes 11-12 = HP
   71637/   3A5F0 :                     ; Bytes 13-14 = Technique used
   71638/   3A5F0 :                     ;	48 = Foi
   71639/   3A5F0 :                     ;	4C = Zan
   71640/   3A5F0 :                     ;	50 = Gra
   71641/   3A5F0 :                     ;	54 = Tsu
   71642/   3A5F0 :                     ;	58 = Gires
   71643/   3A5F0 :                     ;	5C = Poison
   71644/   3A5F0 :                     ; Byte 15 = Technique level
   71645/   3A5F0 :                     ; Byte 16 = Technique Cast %
   71646/   3A5F0 :                     ; Bytes 17-18 = Attack
   71647/   3A5F0 :                     ; Bytes 19-20 = Defense
   71648/   3A5F0 :                     ; Byte 21 = Speed
   71649/   3A5F0 :                     ; Byte 22 = Escape %
   71650/   3A5F0 :                     ; Bytes 23-24 = EXP
   71651/   3A5F0 :                     ; Bytes 25-26 = Meseta
   71652/   3A5F0 :                     ; Byte 27 = ?
   71653/   3A5F0 :                     ; Byte 28 = ?
   71654/   3A5F0 :                     ; Bytes 29-30 = Bitfield; determines tech resistances
   71655/   3A5F0 :                     	; bit 0 = Foi resistance
   71656/   3A5F0 :                         ; bit 1 = Zan resistance
   71657/   3A5F0 :                         ; bit 2 = Gra resistance
   71658/   3A5F0 :                         ; bit 3 = Tsu resistance
   71659/   3A5F0 :                         ; bit 10 = Shiza resistance
