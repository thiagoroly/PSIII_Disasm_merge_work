   60738/   33D14 :                     ; ==============================================
   60739/   33D14 :                     
   60740/   33D14 :                     ; ==============================================
   60741/   33D14 :                     ; The first word for each scene is the number of NPCs on a scene (count - 1);
   60742/   33D14 :                     ; if it's $FFFF, there are no NPCs. After that are the bytes for NPC data
   60743/   33D14 :                     ;
   60744/   33D14 :                     ; Byte 1 = index of the NPCObjectPtrs table
   60745/   33D14 :                     ; Byte 2 = index of the NPCSpriteMappingsPtrs table;
   60746/   33D14 :                     ; Bytes 3-4 = X position
   60747/   33D14 :                     ; Bytes 5-6 = Y position
   60748/   33D14 :                     ; Bytes 7-8 = can have different meanings:
   60749/   33D14 :                     ;	- Script offset
   60750/   33D14 :                     ;	- Shop-related data if byte 1 references an object for shop NPCs (e.g. $08 = Obj_Shopkeeper).
   60751/   33D14 :                     ;		Byte 7 determines the type of shop.
   60752/   33D14 :                     ;			- 0 (items/supply)
   60753/   33D14 :                     ;			- 1 (weapon)
   60754/   33D14 :                     ;			- 2 (armor)
   60755/   33D14 :                     ;			- 3 (clinic/nurse)
   60756/   33D14 :                     ;			- 4 (church)
   60757/   33D14 :                     ;			- 5 (technique distribution)
   60758/   33D14 :                     ;			- 6 (fortune)
   60759/   33D14 :                     ;			- 7 (inn)
   60760/   33D14 :                     ;		Byte 8 refers to the ShopsInventoryData index; if byte 7 is 3 or higher, byte 8's index value is ignored
   60761/   33D14 :                     ; Bytes 9-10 = NPC X/Y position update rate
   60762/   33D14 :                     ; ==============================================
   60763/   33D14 :                     
   60764/   33D14 :                     ; ---------------------------------------
