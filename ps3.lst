   18820/    E0C8 :                     ;
   18821/    E0C8 :                     ; bit 0 = cleared when on the top row of the grid; set when on the bottom row
   18822/    E0C8 :                     ; bit 1 = cleared when on the left column of the grid; set when on the right column
