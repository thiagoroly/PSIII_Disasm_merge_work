   68919/   38772 :                     
   68920/   38772 :                     ; ===============================================================
   68921/   38772 :                     ; Inventory Data
   68922/   38772 :                     ;
   68923/   38772 :                     ; Bytes 1-2 = Unused
   68924/   38772 :                     ; Bytes 3-4 = Pointer to the item's name
   68925/   38772 :                     ; Bytes 5-6 = Cost
   68926/   38772 :                     ; Byte 7 = Animation index (this only matters if the item is equipable for one or both hands)
   68927/   38772 :                     ;		00 = Sword
   68928/   38772 :                     ;		04 = Knife
   68929/   38772 :                     ;		08 = Staff
   68930/   38772 :                     ;		0C = Slicer
   68931/   38772 :                     ;		10 = Claw
   68932/   38772 :                     ;		14 = Bow
   68933/   38772 :                     ;		18 = Shot
   68934/   38772 :                     ;		1C = Needle
   68935/   38772 :                     ; Byte 8 = Target selection (this only matters if the item is equipable for one or both hands)
   68936/   38772 :                     ;		00 = No attack, character defends
   68937/   38772 :                     ;		08 = Single target, close range
   68938/   38772 :                     ;		0A = Single target, long range
   68939/   38772 :                     ;		0C = Front or back row
   68940/   38772 :                     ;		0E = Left or right groups
   68941/   38772 :                     ;		10 = All
   68942/   38772 :                     ; Byte 9 = Attack increase
   68943/   38772 :                     ; Byte 10 = Defense increase
   68944/   38772 :                     ; Byte 11 = Speed increase
   68945/   38772 :                     ; Byte 12 = Technique ID; when the MSB is set, it determines actions to perform in the menu
   68946/   38772 :                     ; Byte 13 = Technique effectiveness
   68947/   38772 :                     ; Byte 14 = Bitfield - Characters that can equip the item
   68948/   38772 :                     ; Byte 15 = Equip where
   68949/   38772 :                     ;		00 = Not equipable
   68950/   38772 :                     ;		04 = Head
   68951/   38772 :                     ;		08 = Single hand
   68952/   38772 :                     ;		OC = Both hands
   68953/   38772 :                     ;		10 = Body
   68954/   38772 :                     ;		14 = Feet
   68955/   38772 :                     ;		18 = Buckle
   68956/   38772 :                     ; Byte 16 = Actions for item ; bitfield
   68957/   38772 :                     ;		bit 0-3: Seemingly unused
   68958/   38772 :                     ;		bit 4: 1 = Shot attribute, ignores enemy defense and damage value remains static with the weapon's power; 0 = Normal damage
   68959/   38772 :                     ;		bit 5: 1 = ??? (Note: Only Knife and ShortSwd are set with this value); 0 = ???
   68960/   38772 :                     ;		bit 6: Discard flag; 1 = Disposable, 0 = Can't throw away
   68961/   38772 :                     ;		bit 7: Consumable flag; 1 = Item is depleted after use, 0 = Reusable item
   68962/   38772 :                     ; ===============================================================
